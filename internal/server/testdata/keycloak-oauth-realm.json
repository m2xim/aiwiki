{
  "realm": "aiwiki-oauth-test",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 120,
  "registrationAllowed": false,
  "verifyEmail": false,
  "roles": {
    "realm": [
      {"name": "aiwiki-access", "description": "Fixture-only aiwiki access role"}
    ]
  },
  "clients": [
    {
      "clientId": "aiwiki-browser",
      "name": "aiwiki browser (fixture)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "fixture-browser-only",
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": false,
      "fullScopeAllowed": true,
      "redirectUris": ["http://127.0.0.1:8090/auth/callback"],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "own-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "aiwiki-browser",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "fixture-sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "fixture-realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "aiwiki-cli",
      "name": "aiwiki MCP client (fixture)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": false,
      "fullScopeAllowed": true,
      "redirectUris": ["http://127.0.0.1:58081/callback"],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [],
      "optionalClientScopes": ["aiwiki:mcp"],
      "protocolMappers": [
        {
          "name": "fixture-sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "fixture-realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "http://127.0.0.1:8090/mcp",
      "name": "aiwiki MCP resource server (fixture, introspection only)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "fixture-mcp-only",
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": false,
      "fullScopeAllowed": true,
      "redirectUris": [],
      "webOrigins": [],
      "attributes": {
        "resource_url": "http://127.0.0.1:8090/mcp"
      },
      "defaultClientScopes": [],
      "optionalClientScopes": []
    }
  ],
  "clientScopes": [
    {
      "name": "aiwiki:mcp",
      "description": "Access to the aiwiki MCP resource",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "aiwiki-mcp-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "http://127.0.0.1:8090/mcp",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "employee",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Fixture",
      "lastName": "Employee",
      "email": "user@example.org",
      "requiredActions": [],
      "credentials": [
        {"type": "password", "value": "fixture-password-only", "temporary": false}
      ],
      "realmRoles": ["aiwiki-access"]
    }
  ]
}
