# Copy to .env.personal (ignored by git) and fill in every value.
#   cp .env.personal.example .env.personal
#   docker compose --env-file .env.personal -f compose.personal.yaml up -d --build
# Use letters and digits in passwords and keys (they are placed into URLs).

# Where the wiki listens on the host. Keep 127.0.0.1 for local use. To serve a
# home network or VPN, set the address of this machine and the matching origin
# that browsers use (both must agree), for example:
#   AIWIKI_BIND_ADDR=192.0.2.10
#   AIWIKI_ALLOWED_ORIGIN=http://192.0.2.10:8090
AIWIKI_BIND_ADDR=127.0.0.1
AIWIKI_PORT=8090
AIWIKI_ALLOWED_ORIGIN=http://127.0.0.1:8090

# Display name of the owner.
AIWIKI_PERSONAL_NAME=Владелец

# PostgreSQL: superuser (used only by the import), table owner, runtime role.
POSTGRES_PASSWORD=
AIWIKI_OWNER_PASSWORD=
AIWIKI_APP_PASSWORD=

# SeaweedFS S3 credentials, shared by the bucket and the wiki.
AIWIKI_S3_ACCESS_KEY=
AIWIKI_S3_SECRET_KEY=

# Optional: default storage limit per space in bytes (0 or empty = unlimited).
AIWIKI_SPACE_QUOTA_BYTES=

# Import only: directory of the trusted-mode installation (wiki.db and files/).
AIWIKI_IMPORT_SOURCE=./data
